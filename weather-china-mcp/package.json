  "main": "src/index.js",
  "files": [
    "src/",
    "city-codes-complete.json",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "weather-china-mcp": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
