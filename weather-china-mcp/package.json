{
  "name": "weather-china-mcp",
  "version": "1.0.4",
  "description": "MCP server for China weather (weather.com.cn) — real-time weather, 5-day forecast, air quality. No API Key required. Works with Claude Desktop, Claude Code, Cursor, Cline, Windsurf, OpenCode.",
