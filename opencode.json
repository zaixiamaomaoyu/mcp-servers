{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "weather-china-mcp": {
      "type": "local",
      "command": ["node", "weather-china-mcp"]
    },
    "open-meteo": {
      "type": "local",
      "command": ["npx", "-y", "open-meteo-mcp-server"]
    },
    "qweather-mcp": {
      "type": "local",
      "command": ["node", "src/index.js"],
      "cwd": "./qweather-mcp"
    }
  }
}